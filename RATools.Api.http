@host = http://localhost:5000

### Health
GET {{host}}/health

### Version
GET {{host}}/version

### ECTD structure tree for US region
GET {{host}}/api/ectd-structure?region=US

### List applications
GET {{host}}/api/applications

### Create application
# @name createApplication
POST {{host}}/api/applications
Content-Type: application/json

{
  "applicationNumber": "IND-0001",
  "region": "US",
  "sponsorName": "Demo Sponsor",
  "workingDirectoryParentPath": "D:\\eCTD-work"
}

### Import existing application workspace
POST {{host}}/api/applications/import
Content-Type: application/json

{
  "workingDirectoryPath": "D:\\eCTD-work\\IND-0001",
  "region": "US",
  "sponsorName": "Demo Sponsor"
}

### Get application by id
GET {{host}}/api/applications/{{createApplication.response.body.$.id}}

### Get publish history by application
GET {{host}}/api/applications/{{createApplication.response.body.$.id}}/publish-history

### Get publish history by application filtered and paged
GET {{host}}/api/applications/{{createApplication.response.body.$.id}}/publish-history?sequenceNumber=0000&page=1&pageSize=20

### Get publish history by application with status and time range
GET {{host}}/api/applications/{{createApplication.response.body.$.id}}/publish-history?status=Completed&createdFromUtc=2026-04-01T00:00:00Z&createdToUtc=2026-04-30T23:59:59Z&page=1&pageSize=20

### Create sequence
POST {{host}}/api/applications/{{createApplication.response.body.$.id}}/sequences
Content-Type: application/json

{
  "sequenceNumber": "0000",
  "submissionType": "original-application",
  "description": "Initial submission"
}

### Invalid sequence validation example
POST {{host}}/api/applications/{{createApplication.response.body.$.id}}/sequences
Content-Type: application/json

{
  "sequenceNumber": "1",
  "submissionType": "",
  "description": ""
}

### Create document
# @name createDocument
POST {{host}}/api/documents
Content-Type: application/json

{
  "fileName": "study-report.pdf",
  "mediaType": "application/pdf",
  "fileSize": 102400,
  "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "storagePath": "files/study-report.pdf"
}

### List documents
GET {{host}}/api/documents

### Get document by id
GET {{host}}/api/documents/{{createDocument.response.body.$.id}}

### Delete document by id
DELETE {{host}}/api/documents/{{createDocument.response.body.$.id}}

### Upload document file
POST {{host}}/api/documents/upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="File"; filename="sample.pdf"
Content-Type: application/pdf

sample upload content
--boundary--

### Upload document directly into a sequence working directory
# Recommended upload path for the canonical section-folder workflow
POST {{host}}/api/applications/{{createApplication.response.body.$.id}}/sequences/0000/documents/upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="File"; filename="sample.pdf"
Content-Type: application/pdf

sample upload content
--boundary
Content-Disposition: form-data; name="CtdSection"

m1.1
--boundary--

### Create document placement
# @name createPlacement
POST {{host}}/api/document-placements
Content-Type: application/json

{
  "documentId": "{{createDocument.response.body.$.id}}",
  "applicationId": "{{createApplication.response.body.$.id}}",
  "sequenceNumber": "0000",
  "ctdSection": "m5.3.5.1",
  "operation": "new",
  "title": "Clinical Study Report"
}

### Reassign a document placement section and move the file to the new canonical folder
PUT {{host}}/api/document-placements/{{createPlacement.response.body.$.id}}/section
Content-Type: application/json

{
  "ctdSection": "m5.3.5.1"
}

### List document placements
GET {{host}}/api/document-placements

### List document placements by application
GET {{host}}/api/document-placements?applicationId={{createApplication.response.body.$.id}}

### Validate sequence before publish
POST {{host}}/api/validation/sequence
Content-Type: application/json

{
  "applicationId": "{{createApplication.response.body.$.id}}",
  "sequenceNumber": "0000"
}

### Generate minimal index.xml backbone
POST {{host}}/api/backbone/generate
Content-Type: application/json

{
  "applicationId": "{{createApplication.response.body.$.id}}",
  "sequenceNumber": "0000"
}

### Expected backbone output path
# Files are written under src/RATools.Api/App_Data/publish/{applicationId-no-dashes}/{sequenceNumber}/index.xml

### Create publish job
# @name createPublishJob
# Response: 201 Created PublishJobDto
POST {{host}}/api/publish-jobs
Content-Type: application/json

{
  "applicationId": "{{createApplication.response.body.$.id}}",
  "sequenceNumber": "0000"
}

### Execute publish and return unified report
# @name executePublishJob
# Response: 200 OK PublishExecutionReportDto
POST {{host}}/api/publish-jobs/execute
Content-Type: application/json

{
  "applicationId": "{{createApplication.response.body.$.id}}",
  "sequenceNumber": "0000"
}

### Publish job now fails early when validation report contains blocking errors

### List publish jobs
GET {{host}}/api/publish-jobs

### Get publish job by id
GET {{host}}/api/publish-jobs/{{createPublishJob.response.body.$.id}}

### Get persisted publish report by job id
GET {{host}}/api/publish-jobs/{{executePublishJob.response.body.$.publishJob.id}}/report

### List artifacts by job id
GET {{host}}/api/publish-jobs/{{executePublishJob.response.body.$.publishJob.id}}/artifacts

### Download persisted publish report
GET {{host}}/api/publish-jobs/{{executePublishJob.response.body.$.publishJob.id}}/artifacts/PublishReport/download

### Publish job should return completed status with outputPath and packagePath when generation succeeds

### Create audit log
POST {{host}}/api/audit-logs
Content-Type: application/json

{
  "entityType": "Application",
  "entityId": "{{createApplication.response.body.$.id}}",
  "action": "Created",
  "actor": "local-user",
  "details": "Initial application bootstrap"
}

### List audit logs
GET {{host}}/api/audit-logs

### Audit logs now include validation and publish job lifecycle events
