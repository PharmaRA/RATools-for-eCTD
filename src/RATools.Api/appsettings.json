{
  "Urls": "http://127.0.0.1:5000",
  "Deployment": {
    "Mode": "LocalOnly",
    "InstanceLockPath": "App_Data/ratools-api.lock"
  },
  "Persistence": {
    "Provider": "PostgreSql"
  },
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=ratools;Username=postgres"
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "BackboneOutput": {
    "RootPath": "App_Data/publish"
  },
  "PublishJobs": {
    "ExecutionTimeout": "00:15:00",
    "PollInterval": "00:00:01",
    "LeaseDuration": "00:01:00",
    "HeartbeatInterval": "00:00:15",
    "RetryDelay": "00:00:05",
    "MaxAttempts": 3
  },
  "Monitoring": {
    "QueueSampleInterval": "00:00:15"
  },
  "ValidationProfile": {
    "Name": "fda-ectd-3.2-manual",
    "Mode": "relaxed"
  },
  "Security": {
    "ApiKey": "",
    "AllowedWorkspaceRoots": [],
    "AllowDestructiveOperations": false
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
