root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Noisy rules start at suggestion and can be promoted as the codebase is cleaned.
dotnet_diagnostic.CA1062.severity = suggestion
dotnet_diagnostic.CA1031.severity = suggestion
dotnet_diagnostic.CA1303.severity = suggestion
dotnet_diagnostic.CA2007.severity = none

# MD5 is used as a non-security file-integrity checksum mandated by the eCTD
# ICH v3.2.2 backbone spec (see LocalBackboneFileWriter, IchIndexXmlWriter).
# SHA256 covers the security-sensitive integrity evidence. Suppress the
# "broken cryptographic algorithm" rule for this intentional, documented use.
dotnet_diagnostic.CA5351.severity = none

[*Tests.cs]
# xUnit test method names use Method_Scenario_Result with underscores by convention.
dotnet_diagnostic.CA1707.severity = none

# These names describe the domain abstractions precisely; renaming them to avoid
# collection suffixes would make the API less clear.
[src/RATools.Application/Publishing/IPublishJobQueue.cs]
dotnet_diagnostic.CA1711.severity = none

[src/RATools.Application/Validation/SectionDictionary.cs]
dotnet_diagnostic.CA1711.severity = none

[src/RATools.Infrastructure/Publishing/ChannelPublishJobQueue.cs]
dotnet_diagnostic.CA1711.severity = none

[tests/RATools.Tests/Publishing/FakePublishJobQueue.cs]
dotnet_diagnostic.CA1711.severity = none

# EF migration operations are generated historical snapshots. Rewriting their
# inline column arrays adds churn and can make future migration diffs misleading.
[src/RATools.Infrastructure/Persistence/EfCore/Migrations/*.cs]
dotnet_diagnostic.CA1825.severity = none
dotnet_diagnostic.CA1861.severity = none

[*.{ts,tsx,js,jsx,json,yml,yaml,css}]
indent_style = space
indent_size = 2

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2
